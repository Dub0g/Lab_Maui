<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<Color x:Key="Bg">#0B1020</Color>
	<Color x:Key="CardBg">#1B2333</Color>
	<Color x:Key="SheetBg">#1F2937</Color>
	<Color x:Key="InputBg">#111827</Color>
	<Color x:Key="Line">#2A3447</Color>
	<Color x:Key="Accent">#FBBF24</Color>
	<Color x:Key="AccentText">#1A1305</Color>
	<Color x:Key="TextPrimary">#FFFFFF</Color>
	<Color x:Key="Muted">#8B95A7</Color>
	<Color x:Key="Success">#34D399</Color>
	<Color x:Key="Danger">#F87171</Color>
	<Color x:Key="AccentSoft">#2EFBBF24</Color>

	<SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}" />
	<SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />

</ResourceDictionary>
