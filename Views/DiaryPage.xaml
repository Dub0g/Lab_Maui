<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SleepHelper.Models"
             x:Class="SleepHelper.Views.DiaryPage"
             Title="Щоденник">
	<Grid RowDefinitions="Auto,*,Auto" Padding="20,12,20,12" RowSpacing="0">

		<VerticalStackLayout Spacing="4" Margin="0,0,0,16">
			<Label Text="Щоденник сну" Style="{StaticResource H1}" />
			<Label Text="Ваші записи про сон" Style="{StaticResource MutedLabel}" />
		</VerticalStackLayout>

		<Label Grid.Row="1" Text="Поки що немає записів. Додайте перший!"
		       IsVisible="{Binding IsEmpty}" TextColor="{StaticResource Muted}"
		       HorizontalOptions="Center" VerticalOptions="Start" Margin="0,40,0,0"
		       HorizontalTextAlignment="Center" />

		<CollectionView Grid.Row="1" ItemsSource="{Binding Entries}">
			<CollectionView.ItemsLayout>
				<LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
			</CollectionView.ItemsLayout>
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="models:SleepEntry">
					<Border Style="{StaticResource Card}">
						<Grid ColumnDefinitions="*,Auto">
							<VerticalStackLayout Spacing="4">
								<Label Text="{Binding Range}" FontSize="20" FontAttributes="Bold" />
								<Label Text="{Binding Meta}" FontSize="12" TextColor="{StaticResource Muted}" />
								<Label Text="{Binding Notes}" IsVisible="{Binding HasNotes}"
								       FontSize="13" FontAttributes="Italic"
								       TextColor="{StaticResource Muted}" Margin="0,4,0,0" />
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
								<Label Text="{Binding QualityEmoji}" FontSize="24" HorizontalOptions="Center" />
								<Label Text="{Binding SyncGlyph}" FontSize="12" HorizontalOptions="Center"
								       TextColor="{Binding SyncColor}" />
							</VerticalStackLayout>
						</Grid>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<Button Grid.Row="2" Text="＋  Додати запис" Style="{StaticResource PrimaryButton}"
		        Command="{Binding AddEntryCommand}" Margin="0,12,0,0" />
	</Grid>
</ContentPage>
