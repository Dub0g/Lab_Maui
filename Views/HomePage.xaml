<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SleepHelper.Views.HomePage"
             Title="Головна">
	<ScrollView>
		<VerticalStackLayout Padding="20,12,20,24" Spacing="0">

			<Grid ColumnDefinitions="*,Auto">
				<VerticalStackLayout Spacing="2">
					<Label Text="{Binding Greeting}" Style="{StaticResource MutedLabel}" />
					<Label Text="{Binding UserName}" FontSize="24" FontAttributes="Bold" />
				</VerticalStackLayout>
				<Border Grid.Column="1" WidthRequest="40" HeightRequest="40"
				        BackgroundColor="{StaticResource Accent}" StrokeThickness="0"
				        StrokeShape="RoundRectangle 20">
					<Label Text="{Binding UserInitial}" TextColor="{StaticResource AccentText}"
					       FontSize="16" FontAttributes="Bold"
					       HorizontalOptions="Center" VerticalOptions="Center" />
				</Border>
			</Grid>

			<!-- Картка якості сну -->
			<Border Style="{StaticResource Card}" Padding="18" Margin="0,20,0,0"
			        StrokeShape="RoundRectangle 20">
				<VerticalStackLayout Spacing="6">
					<Label Text="Якість сну" Style="{StaticResource MutedLabel}" />

					<VerticalStackLayout IsVisible="{Binding HasData}" Spacing="10">
						<HorizontalStackLayout>
							<Label Text="{Binding PercentText}" FontSize="40" FontAttributes="Bold" />
							<Label Text="%" FontSize="20" TextColor="{StaticResource Accent}"
							       VerticalOptions="End" Margin="2,0,0,8" />
						</HorizontalStackLayout>
						<ProgressBar Progress="{Binding Progress}"
						             ProgressColor="{StaticResource Accent}"
						             BackgroundColor="{StaticResource InputBg}" />
						<Label Text="{Binding Summary}" FontSize="12" LineHeight="1.4"
						       TextColor="{StaticResource Muted}" />
					</VerticalStackLayout>

					<VerticalStackLayout IsVisible="{Binding NoData}" Spacing="12">
						<Label Text="—" FontSize="40" FontAttributes="Bold" />
						<Label Text="Додайте перший запис у щоденнику, і тут з’явиться ваша статистика."
						       FontSize="12" LineHeight="1.4" TextColor="{StaticResource Muted}" />
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<Label Text="Швидкий доступ" FontSize="17" FontAttributes="Bold" Margin="0,26,0,12" />

			<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
				<Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="14" HeightRequest="96">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding GoCommand}" CommandParameter="Diary" />
					</Border.GestureRecognizers>
					<Grid RowDefinitions="Auto,*">
						<Border WidthRequest="38" HeightRequest="38" HorizontalOptions="Start"
						        BackgroundColor="#26818CF8" StrokeThickness="0" StrokeShape="RoundRectangle 10">
							<Label Text="📖" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
						</Border>
						<Label Grid.Row="1" Text="Щоденник" FontSize="13" FontAttributes="Bold" VerticalOptions="End" />
					</Grid>
				</Border>

				<Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="14" HeightRequest="96">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding GoCommand}" CommandParameter="Calc" />
					</Border.GestureRecognizers>
					<Grid RowDefinitions="Auto,*">
						<Border WidthRequest="38" HeightRequest="38" HorizontalOptions="Start"
						        BackgroundColor="#26FBBF24" StrokeThickness="0" StrokeShape="RoundRectangle 10">
							<Label Text="🧮" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
						</Border>
						<Label Grid.Row="1" Text="Розрахунок" FontSize="13" FontAttributes="Bold" VerticalOptions="End" />
					</Grid>
				</Border>

				<Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="14" HeightRequest="96">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding GoCommand}" CommandParameter="Relax" />
					</Border.GestureRecognizers>
					<Grid RowDefinitions="Auto,*">
						<Border WidthRequest="38" HeightRequest="38" HorizontalOptions="Start"
						        BackgroundColor="#2638BDF8" StrokeThickness="0" StrokeShape="RoundRectangle 10">
							<Label Text="💧" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
						</Border>
						<Label Grid.Row="1" Text="Дихання" FontSize="13" FontAttributes="Bold" VerticalOptions="End" />
					</Grid>
				</Border>

				<Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="14" HeightRequest="96">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding GoCommand}" CommandParameter="Relax" />
					</Border.GestureRecognizers>
					<Grid RowDefinitions="Auto,*">
						<Border WidthRequest="38" HeightRequest="38" HorizontalOptions="Start"
						        BackgroundColor="#2634D399" StrokeThickness="0" StrokeShape="RoundRectangle 10">
							<Label Text="🎵" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
						</Border>
						<Label Grid.Row="1" Text="Звуки" FontSize="13" FontAttributes="Bold" VerticalOptions="End" />
					</Grid>
				</Border>
			</Grid>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
