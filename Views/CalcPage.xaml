<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SleepHelper.Models"
             x:Class="SleepHelper.Views.CalcPage"
             Title="Розрахунок">
	<ScrollView>
		<VerticalStackLayout Padding="20,12,20,24" Spacing="0">

			<Label Text="Калькулятор сну" Style="{StaticResource H1}" />
			<Label Text="{Binding CycleSubtitle}" Style="{StaticResource MutedLabel}" Margin="0,4,0,20" />

			<!-- Перемикач режиму -->
			<Border Style="{StaticResource Card}" Padding="4" StrokeShape="RoundRectangle 14">
				<Grid ColumnDefinitions="*,*">
					<Border BackgroundColor="{Binding WakeTabBg}" StrokeThickness="0"
					        StrokeShape="RoundRectangle 10" Padding="0,11">
						<Border.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding SetModeCommand}" CommandParameter="wake" />
						</Border.GestureRecognizers>
						<Label Text="Хочу прокинутись" FontSize="13" FontAttributes="Bold"
						       TextColor="{Binding WakeTabText}" HorizontalOptions="Center" />
					</Border>
					<Border Grid.Column="1" BackgroundColor="{Binding BedTabBg}" StrokeThickness="0"
					        StrokeShape="RoundRectangle 10" Padding="0,11">
						<Border.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding SetModeCommand}" CommandParameter="bed" />
						</Border.GestureRecognizers>
						<Label Text="Хочу лягти" FontSize="13" FontAttributes="Bold"
						       TextColor="{Binding BedTabText}" HorizontalOptions="Center" />
					</Border>
				</Grid>
			</Border>

			<!-- Вибір часу -->
			<VerticalStackLayout Margin="0,28,0,0" Spacing="4" HorizontalOptions="Fill">
				<TimePicker Time="{Binding Time}" FontSize="76" FontAttributes="Bold"
				            HorizontalOptions="Center" />
				<HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
					<Label Text="{Binding TimeGlyph}" FontSize="13" />
					<Label Text="{Binding TimeCaption}" FontSize="13" FontAttributes="Bold"
					       TextColor="{StaticResource Accent}" />
				</HorizontalStackLayout>
				<Label Text="Торкніться часу, щоб змінити" FontSize="11"
				       TextColor="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,2,0,0" />
			</VerticalStackLayout>

			<Button Text="Розрахувати" Style="{StaticResource PrimaryButton}"
			        Command="{Binding CalculateCommand}" Margin="0,24,0,0" />

			<VerticalStackLayout IsVisible="{Binding HasResults}" Margin="0,24,0,0" Spacing="10">
				<Label Text="{Binding ResultsHeader}" FontSize="12" FontAttributes="Bold"
				       TextColor="{StaticResource Muted}" />

				<VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}" Spacing="10">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="models:CycleResult">
							<Border Style="{StaticResource Card}" Stroke="{Binding BorderBrush}">
								<Grid ColumnDefinitions="*,Auto">
									<VerticalStackLayout Spacing="4">
										<Label Text="{Binding TimeText}" FontSize="24" FontAttributes="Bold" />
										<Label Text="{Binding Description}" FontSize="12"
										       TextColor="{StaticResource Muted}" />
									</VerticalStackLayout>
									<Border Grid.Column="1" BackgroundColor="{Binding BadgeBg}" StrokeThickness="0"
									        StrokeShape="RoundRectangle 999" Padding="10,5" VerticalOptions="Center">
										<Label Text="{Binding Badge}" FontSize="11" FontAttributes="Bold"
										       TextColor="{Binding BadgeText}" />
									</Border>
								</Grid>
							</Border>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>

				<Label Text="{Binding FooterNote}" FontSize="12" LineHeight="1.4"
				       TextColor="{StaticResource Muted}" Margin="0,6,0,0" />
			</VerticalStackLayout>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
